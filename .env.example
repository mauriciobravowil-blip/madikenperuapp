# Copia estas variables a tu entorno de despliegue. NUNCA publiques este archivo con valores reales.

# Obligatorio en producción: URL pública con HTTPS, sin barra final.
MADIKEN_BASE_URL=https://tudominio.com

# Red y puerto. En PaaS (Render, Railway, Fly) PORT lo asigna el proveedor.
MADIKEN_HOST=0.0.0.0
MADIKEN_PORT=8000
COOKIE_SECURE=1

# Persistencia: apunta a un disco persistente en producción.
MADIKEN_DB=./data/madiken.db
MADIKEN_UPLOADS=./public/uploads

# Solo si el frontend está en otro dominio (Netlify + API externa).
# Separa varios orígenes con comas. Habilita CORS y cookies SameSite=None.
MADIKEN_FRONTEND_URL=https://madikenperuapp.netlify.app
TRUSTED_PROXY=1

# IA (opcional). Si no se configura, MADIKEN IA usa el motor local basado en SQLite.
AI_PROVIDER=local
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
